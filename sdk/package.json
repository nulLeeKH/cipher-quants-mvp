{
  "name": "@cipher-quants/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Cipher Quants Program (Pinocchio dispatch)",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "require": "./dist/accounts/index.js",
      "default": "./dist/accounts/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "require": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest --rootDir=. --testMatch='<rootDir>/src/**/*.test.ts'"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": ">=1.90.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^29.0.3",
    "@types/node": "^20.0.0",
    "jest": "^29.0.3",
    "ts-jest": "^29.0.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "peerDependencies": {
    "@solana/web3.js": ">=1.90.0"
  },
  "license": "MIT"
}
