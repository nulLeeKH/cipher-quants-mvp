{
  "name": "cipher-quants-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:mainnet": "./scripts/build.sh mainnet",
    "build:devnet": "./scripts/build.sh devnet",
    "build:localnet": "./scripts/build.sh localnet",
    "test": "pnpm sdk:build && ./scripts/test.sh",
    "validator:up": "./scripts/validator-up.sh",
    "validator:down": "./scripts/validator-down.sh",
    "cu:measure": "./scripts/measure-cu.sh",
    "sdk:build": "pnpm --filter @cipher-quants/sdk build",
    "sdk:dev": "pnpm --filter @cipher-quants/sdk dev",
    "app:build": "pnpm --filter @solana-boilerplate/app build",
    "app:dev": "pnpm --filter @solana-boilerplate/app dev",
    "keeper:dev": "cd keeper && deno task dev",
    "api:dev": "cd api && deno task dev"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/jest": "^29.0.3",
    "@types/node": "^20.0.0",
    "jest": "^29.0.3",
    "prettier": "^2.6.2",
    "ts-jest": "^29.0.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "testTimeout": 180000
  },
  "pnpm": {
    "neverBuiltDependencies": ["@stellar/stellar-sdk"]
  }
}
