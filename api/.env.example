# Cipher Quants API Server — environment variables
# 24/7 RFQ webhook (JupiterZ-compatible).
#
# Copy to .env (gitignored) and fill in:  cp api/.env.example api/.env

# ----- RPC -----
RPC_URL=http://127.0.0.1:8899
# RPC_WS_URL=ws://127.0.0.1:8900
RPC_PROVIDER=localnet

# ----- Quote signer wallet -----
# Ed25519 keypair JSON (64-byte secretKey array).
# PoC: same oracle hot key as the keeper. In production, split into a dedicated quote_signer.
QUOTE_SIGNER_WALLET_PATH=/Users/me/.config/solana/oracle.json

# ----- Protocol -----
# PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target -----
# BASE_MINT=
# QUOTE_MINT=

# ----- Token metadata (returned by GET /tokens) -----
# Decimals MUST match the on-chain mint or downstream UIs render wrong
# quantities. Symbols are informational; aggregator UIs use them when no
# separate token-list lookup is available.
BASE_SYMBOL=BASE
BASE_DECIMALS=6
QUOTE_SYMBOL=QUOTE
QUOTE_DECIMALS=6

# ----- HTTP -----
API_PORT=8080
# Quote expiry window (slots from current). 200 slots ≈ 80s with 400ms/slot.
QUOTE_VALID_WINDOW_SLOTS=200

# ----- Last-look (Maker-side reject gate at /swap) -----
# At /swap time the MM re-reads pool.fair_value and rejects (409 PriceDrift)
# if |now - at_quote| > this in bps. 50 = 0.5%. JupiterZ allows up to ~5%
# fill failure (95% SLA) — staying well under that. Raise for highly
# volatile / wider-spread assets, lower for tight pairs.
MM_MAX_DRIFT_BPS=50

# ----- Metrics -----
# Bearer token required to read /metrics. If unset, /metrics returns 503
# (fail-closed). Generate a fresh one:  openssl rand -hex 32
# METRICS_AUTH_TOKEN=

# ----- Rate limit (per-IP sliding 1-second window) -----
# Tune against legitimate traffic. /quote has its own bucket because it does
# RPC fan-out; everything else (POST /swap, GET /tokens, ...) shares the
# DEFAULT bucket.
RATE_LIMIT_QUOTE_PER_SEC=30
RATE_LIMIT_DEFAULT_PER_SEC=60

# ----- Misc -----
VERBOSE=false
