# Cipher Quants API Server — PRODUCTION environment template
# Copy to .env on the production host and fill in. Never commit the filled file.

# ----- RPC -----
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE-ME
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE-ME
RPC_PROVIDER=helius-developer

# ----- Quote signer wallet -----
# Production should split this from the keeper's oracle_signer (call
# rotate_oracle_signer on-chain, then point keeper + api at different keys).
QUOTE_SIGNER_WALLET_PATH=/var/lib/cipher-quants/keys/quote-signer.json

# ----- Protocol -----
PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target -----
BASE_MINT=REPLACE-WITH-MAINNET-BASE-MINT
QUOTE_MINT=REPLACE-WITH-MAINNET-QUOTE-MINT

# ----- HTTP -----
API_PORT=8080
# Quote expiry window (slots). 200 slots ≈ 80s @ 400ms/slot.
QUOTE_VALID_WINDOW_SLOTS=200

# ----- Rate limiting (per-IP, sliding 1-second window) -----
# Tune against legitimate traffic. Anything noticeably below the JupiterZ
# fulfill-rate budget should trigger a review.
RATE_LIMIT_QUOTE_PER_SEC=30
RATE_LIMIT_DEFAULT_PER_SEC=60

# ----- Metrics -----
# Bearer token required to read /metrics. If unset, /metrics returns 503 (fail-closed).
METRICS_AUTH_TOKEN=REPLACE-WITH-LONG-RANDOM-STRING

# ----- Misc -----
VERBOSE=false
