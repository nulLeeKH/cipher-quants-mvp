# Cipher Quants Keeper — environment variables
# Copy to .env (gitignored) and fill in.
# docs/OPERATIONS.md §13 — PoC uses .env + an isolated host; production should migrate to Turnkey / AWS KMS.

# ----- RPC -----
RPC_URL=http://127.0.0.1:8899
# RPC_WS_URL=ws://127.0.0.1:8900
RPC_PROVIDER=localnet

# ----- Wallets -----
# Solana keypair JSON files (64-byte secretKey array). 3-tier separation from day 1:
#   oracle  = hot (auto, oracle push + RFQ sign)
#   admin   = warm (manual, set_paused/rotate/withdraw)
#   payer   = can reuse the admin keypair
ORACLE_WALLET_PATH=/Users/me/.config/solana/oracle.json
ADMIN_WALLET_PATH=/Users/me/.config/solana/admin.json
FEE_PAYER_WALLET_PATH=/Users/me/.config/solana/admin.json

# ----- Protocol -----
# Optional override. Defaults to the SDK's PROGRAM_ID (declare_id!).
# PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target -----
# base/quote mints of the pool this keeper operates (created once via the init-pool subcommand).
# BASE_MINT=
# QUOTE_MINT=

# ----- Oracle worker timing (ms) -----
# Mode A push interval (Aggressive — high-volatility window)
ORACLE_MODE_A_PUSH_INTERVAL_MS=200
# Mode B threshold-evaluation interval (Light Hybrid — normal trading)
ORACLE_MODE_B_EVAL_INTERVAL_MS=1000
# Mode C polling (RFQ Only — mostly idle, just for mode-transition detection)
ORACLE_MODE_C_POLL_INTERVAL_MS=30000

# ----- RFQ webhook -----
# HTTP server port
WEBHOOK_PORT=8080
# Quote expiry window (slots from current). 200 slots ≈ 80s with 400ms/slot.
QUOTE_VALID_WINDOW_SLOTS=200

# ----- Misc -----
VERBOSE=false
