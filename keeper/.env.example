# Cipher Quants Keeper — environment variables
# Copy to .env (gitignored) and fill in.
# docs/OPERATIONS.md §13 — PoC uses .env + an isolated host; production should migrate to Turnkey / AWS KMS.

# ----- RPC -----
RPC_URL=http://127.0.0.1:8899
# RPC_WS_URL=ws://127.0.0.1:8900
RPC_PROVIDER=localnet

# ----- Wallets -----
# Solana keypair JSON files (64-byte secretKey array). 4-tier separation:
#   oracle        = hot (auto, on-chain update_oracle pushes — keeper)
#   quote_signer  = hot (auto, RFQ ed25519 quote signing — api server)
#   admin         = warm (manual, set_paused/rotate/withdraw)
#   payer         = can reuse the admin keypair
# Splitting oracle from quote_signer halves blast radius if either box is
# compromised. QUOTE_SIGNER_WALLET_PATH is only read by `keeper init-pool`
# (records the pubkey into authorized_quote_signer); the api server reads
# its own QUOTE_SIGNER_WALLET_PATH in api/.env.
ORACLE_WALLET_PATH=/Users/me/.config/solana/oracle.json
ADMIN_WALLET_PATH=/Users/me/.config/solana/admin.json
FEE_PAYER_WALLET_PATH=/Users/me/.config/solana/admin.json
# Unset → init-pool falls back to ORACLE_WALLET_PATH (PoC single-key default).
# QUOTE_SIGNER_WALLET_PATH=/Users/me/.config/solana/quote-signer.json

# ----- Protocol -----
# Optional override. Defaults to the SDK's PROGRAM_ID (declare_id!).
# PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target -----
# base/quote mints of the pool this keeper operates (created once via the init-pool subcommand).
# BASE_MINT=
# QUOTE_MINT=

# ----- Price source -----
# `mock` (default) emits a random walk — fine for local dev / localnet smoke.
# `pyth`           consumes the Pyth Hermes endpoint (free, no API key).
PRICE_SOURCE=mock

# ----- Pyth Hermes options (used when PRICE_SOURCE=pyth) -----
# 64-char hex feed id (no leading 0x). Browse:
#   https://pyth.network/developers/price-feed-ids
#   SOL/USD   ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
#   BTC/USD   e62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43
#   AAPL/USD  49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688
# PYTH_FEED_ID=
# Override the Hermes base URL (mirrors, self-hosted gateway, etc.).
# PYTH_HERMES_URL=https://hermes.pyth.network
# Transport: `sse` (default) is push-based and matches Pyth's ~400 ms
# publish cadence with zero polling overhead. Switch to `poll` only if a
# corporate proxy drops long-lived connections.
PYTH_TRANSPORT=sse
# Price kind: `spot` (default) or `ema`. EMA is the Pyth-smoothed price —
# less reactive but more robust to single-publisher noise.
PYTH_QUOTE_KIND=spot
# Ticks older than this are tagged `stale` and the worker refuses to push
# them. Default 60 s. Equity feeds will trip this after-hours by design,
# and the worker forces Mode C — that's correct behaviour.
PYTH_MAX_STALENESS_SEC=60
# Poll cadence (ms). Only used when PYTH_TRANSPORT=poll. Default 1000.
# PRICE_SOURCE_POLL_MS=

# ----- Basis adjustment (underlying → tokenized) -----
# Pyth publishes the *underlying* asset (NYSE AAPL, native BTC). For
# tokenized representations (xStocks, wrapped assets) there is a basis to
# the on-chain token. Signed bps offset; +100 = tokenized trades 1 %
# above underlying. ±5000 hard cap.
#
# For crypto pairs (BTC/USDC, SOL/USDC) leave at 0. For xStocks, measure
# the average basis vs underlying over a window and set it here. A
# dynamic basis feed will replace this constant once available — the
# keeper code path stays the same (see sources/basis.ts).
BASIS_ADJUSTMENT_BPS=0

# ----- Oracle worker timing (ms) -----
# Mode A push interval (Aggressive — high-volatility window)
ORACLE_MODE_A_PUSH_INTERVAL_MS=200
# Mode B threshold-evaluation interval (Light Hybrid — normal trading)
ORACLE_MODE_B_EVAL_INTERVAL_MS=1000
# Mode C polling (RFQ Only — mostly idle, just for mode-transition detection)
ORACLE_MODE_C_POLL_INTERVAL_MS=30000

# ----- Priority fees (microlamports per CU) -----
# Bumps the keeper's update_oracle tx priority so it lands ahead of stale
# quotes inside the same block (cancel-priority window). Defaults are tuned
# for localnet; raise both 2–10× on mainnet during volatile windows.
ORACLE_MODE_A_PRIORITY_FEE_MICROLAMPORTS=50000
ORACLE_MODE_B_PRIORITY_FEE_MICROLAMPORTS=5000

# ----- Misc -----
VERBOSE=false

# NOTE: WEBHOOK_PORT / QUOTE_VALID_WINDOW_SLOTS used to be here when the
# keeper bundled the RFQ webhook. Those vars now belong to api/.env.example;
# the keeper doesn't read them.
