{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@cipher-quants/keeper",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "_perms": "--allow-read --allow-write --allow-env --allow-net --allow-sys",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --unstable-sloppy-imports src/main.ts",
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --unstable-sloppy-imports src/main.ts oracle",
    "oracle": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --unstable-sloppy-imports src/main.ts oracle",
    "init-pool": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --unstable-sloppy-imports src/main.ts init-pool",
    "status": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --unstable-sloppy-imports src/main.ts status",
    "check": "deno check --unstable-sloppy-imports src/main.ts",
    "test": "deno test --unstable-sloppy-imports --no-check src/",
    "compile": "deno compile -A --unstable-sloppy-imports --output keeper-bot src/main.ts"
  },
  "imports": {
    "@cipher-quants/sdk": "../sdk/dist/index.js",
    "@solana/web3.js": "npm:@solana/web3.js@1.98.0",
    "@solana/spl-token": "npm:@solana/spl-token@0.4.14",
    "bs58": "npm:bs58@^6.0.0",
    "bn.js": "npm:bn.js@5.2.1",
    "events": "node:events",
    "buffer": "node:buffer",
    "@std/cli": "jsr:@std/cli@1.0.0",
    "@std/fmt": "jsr:@std/fmt@1.0.0",
    "@std/dotenv": "jsr:@std/dotenv@0.225.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "lib": ["deno.window", "deno.ns", "esnext"]
  },
  "unstable": ["sloppy-imports", "detect-cjs"],
  "nodeModulesDir": "auto"
}
