# Cipher Quants Keeper — PRODUCTION environment template
# Copy to .env on the production host and fill in. Never commit the filled file.
#
# Differences from .env.example (dev):
#   - RPC: paid Helius / dedicated Triton (NOT public localhost)
#   - Wallets: KMS-managed in the long run (Turnkey / AWS KMS Ed25519).
#     For migration, files must be chmod 600 and live on an encrypted volume.
#   - Mode-A priority fee bumped (real congestion).
#   - Verbose logging OFF (use structured logging upstream).

# ----- RPC -----
# Paid Helius endpoint with domain ACL bound to this host's egress IP.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE-ME
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE-ME
RPC_PROVIDER=helius-developer

# ----- Wallets (4-tier separation, day 1) -----
# Production MUST split oracle (keeper) from quote_signer (api server) so a
# compromise of either box does not leak the other capability. JSON-file
# paths are placeholders for the migration to Turnkey / AWS KMS Ed25519.
# Keep `chmod 600` until that ships.
ORACLE_WALLET_PATH=/var/lib/cipher-quants/keys/oracle.json
ADMIN_WALLET_PATH=/var/lib/cipher-quants/keys/admin.json
FEE_PAYER_WALLET_PATH=/var/lib/cipher-quants/keys/admin.json
QUOTE_SIGNER_WALLET_PATH=/var/lib/cipher-quants/keys/quote-signer.json

# ----- Protocol -----
# Mainnet program ID (must match programs/protocol/src/lib.rs declare_id!)
PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target -----
BASE_MINT=REPLACE-WITH-MAINNET-BASE-MINT
QUOTE_MINT=REPLACE-WITH-MAINNET-QUOTE-MINT

# ----- Price source -----
# Production should NOT use `mock`. Pick one real adapter:
#   pyth   — Pyth Hermes (SSE default, no API key, ~400ms publish cadence)
PRICE_SOURCE=pyth

# ----- Pyth Hermes options (when PRICE_SOURCE=pyth) -----
# 64-char hex feed id. Browse https://pyth.network/developers/price-feed-ids
PYTH_FEED_ID=REPLACE-WITH-FEED-ID
# Hermes base URL — default is sufficient unless a regional mirror is needed.
PYTH_HERMES_URL=https://hermes.pyth.network
# Transport: sse (push, default) recommended in prod for lowest latency.
PYTH_TRANSPORT=sse
# spot (default) | ema (smoother, less reactive)
PYTH_QUOTE_KIND=spot
# Worker tags ticks `stale` after this; equity feeds will trip after NYSE
# close → worker auto-downgrades to Mode C, RFQ takes over. Correct.
PYTH_MAX_STALENESS_SEC=60
# Only used when PYTH_TRANSPORT=poll; SSE ignores this.
# PRICE_SOURCE_POLL_MS=1000

# ----- Basis adjustment (underlying → tokenized) -----
# Pyth publishes the underlying asset price (e.g. NYSE AAPL). For tokenized
# representations (xStocks) measure the average basis vs underlying over a
# rolling window and set this. Signed bps; +100 = tokenized trades 1%
# above underlying. ±5000 hard cap. Keep at 0 for crypto pairs (BTC/USDC).
BASIS_ADJUSTMENT_BPS=0

# ----- Oracle worker timing -----
ORACLE_MODE_A_PUSH_INTERVAL_MS=200
ORACLE_MODE_B_EVAL_INTERVAL_MS=1000
ORACLE_MODE_C_POLL_INTERVAL_MS=30000

# ----- Cancel-priority compute-unit fees (microLamports / CU) -----
# Tune against real congestion. Defaults below are starting points; observe
# land rate and Jito tip distributions and bump as needed.
ORACLE_MODE_A_PRIORITY_FEE_MICROLAMPORTS=100000
ORACLE_MODE_B_PRIORITY_FEE_MICROLAMPORTS=10000

# ----- Misc -----
VERBOSE=false
