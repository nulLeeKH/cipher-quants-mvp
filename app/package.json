{
  "name": "@cipher-quants/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@cipher-quants/sdk": "workspace:*",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/wallet-adapter-ledger": "^0.9.29",
    "@solana-mobile/wallet-adapter-mobile": "^2.1.4",
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.14",
    "bn.js": "^5.2.1",
    "jose": "^5.9.6",
    "tweetnacl": "^1.0.3",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "lucide-react": "^0.456.0",
    "react-hook-form": "^7.53.2",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "@types/bn.js": "^5.1.0",
    "@types/jest": "^29.0.3",
    "jest": "^29.0.3",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.0.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    },
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": ["/node_modules/", "/.next/"],
    "transformIgnorePatterns": [
      "node_modules/.pnpm/(?!(uuid|jayson|@noble\\+|@solana\\+|jose|superstruct|rpc-websockets|@coral-xyz\\+)@)",
      "node_modules/(?!(uuid|jayson|@noble|@solana|jose|superstruct|rpc-websockets|@coral-xyz)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@cipher-quants/sdk$": "<rootDir>/../sdk/dist/index.js",
      "^@cipher-quants/sdk/(.*)$": "<rootDir>/../sdk/dist/$1"
    },
    "setupFiles": ["<rootDir>/jest.polyfills.ts"],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"]
  }
}
