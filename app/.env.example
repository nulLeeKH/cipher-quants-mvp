# App — Next.js
#
# Copy this file to `.env.local` (gitignored) for local development:
#   cp app/.env.example app/.env.local
# For production builds, use `.env.production` or set vars in the hosting
# platform (Vercel / Cloud Run / etc.).
#
# Naming convention:
#   NEXT_PUBLIC_* → exposed to the browser bundle. Never put secrets here.
#   Everything else → server-only (route handlers, middleware, SSR).

# ----- RPC (browser-side) -----
# Helius Secure RPC endpoint (protected by a domain ACL), or localnet.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# NEXT_PUBLIC_RPC_WS_URL=ws://127.0.0.1:8900

# ----- Cluster label -----
NEXT_PUBLIC_CLUSTER=localnet

# ----- Program ID override (optional; defaults to the SDK IDL value) -----
# NEXT_PUBLIC_PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target (browser) -----
# NEXT_PUBLIC_BASE_MINT=
# NEXT_PUBLIC_QUOTE_MINT=

# ----- API server URL (RFQ webhook) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Admin auth (server-only) -----
# JWT signing key for admin sessions. MUST be ≥ 16 characters; in production
# (NODE_ENV=production) the server fails to boot if this is unset or short.
# Generate a fresh one:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# Challenge expiry (minutes) — how long a /challenge JWT is valid for sign-in.
ADMIN_CHALLENGE_EXP_MIN=5
# Session JWT expiry (hours) — how long a logged-in admin stays signed in.
ADMIN_JWT_EXP_HOURS=1
