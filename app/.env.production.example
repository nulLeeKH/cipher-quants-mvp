# App (Next.js) — PRODUCTION environment template
# Copy to .env.production on the production host and fill in.
# Public (browser): NEXT_PUBLIC_*. Server-only: everything else.

# ----- RPC (browser-side) -----
# Use a Helius Secure RPC endpoint bound to the deploy domain via ACL.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE-ME
NEXT_PUBLIC_RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE-ME

# ----- Cluster label -----
NEXT_PUBLIC_CLUSTER=mainnet-beta

# ----- Program ID -----
NEXT_PUBLIC_PROGRAM_ID=3br2wCsENbm6GfH3cfJVzZK5GKWNJZBD6oEX2rMNxNMy

# ----- Pool target (browser) -----
NEXT_PUBLIC_BASE_MINT=REPLACE-WITH-MAINNET-BASE-MINT
NEXT_PUBLIC_QUOTE_MINT=REPLACE-WITH-MAINNET-QUOTE-MINT

# ----- API server URL (RFQ webhook) -----
NEXT_PUBLIC_API_BASE_URL=https://api.cipher-quants.example

# ----- Admin auth (server-only) -----
# At least 32 random characters in production (e.g. `openssl rand -base64 32`).
JWT_SECRET=REPLACE-WITH-LONG-RANDOM-STRING-32-OR-MORE-CHARACTERS
ADMIN_CHALLENGE_EXP_MIN=5
ADMIN_JWT_EXP_HOURS=1

# ----- Node env -----
NODE_ENV=production
